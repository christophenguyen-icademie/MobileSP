        "foregroundImage": "./assets/images/ecusson_troyes.jpg",
        "backgroundColor": "#1f176a"
      },
      "package": "com.nguyenvanchristophe.mobilesp"
    },
    "web": {
      "favicon": "./assets/images/ecusson_troyes.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "5c9e833d-e8fd-4d71-9cb4-9f963d1d5e27"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
