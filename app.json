{
  "expo": {
    "name": "MobileSP",
    "slug": "mobilesp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ecusson_troyes.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/sdis10.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
