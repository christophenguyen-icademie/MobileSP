# local (valeur par défaut) ou remote
EXPO_PUBLIC_SERVICES_MODE=local

# localhost pour le Web/iOS, 10.0.2.2 pour l'émulateur Android, ou l'IP du
# poste Docker pour un téléphone physique.
EXPO_PUBLIC_LOCAL_SERVICES_HOST=localhost

# Requis uniquement avec EXPO_PUBLIC_SERVICES_MODE=remote.
EXPO_PUBLIC_ORS_API_KEY=
